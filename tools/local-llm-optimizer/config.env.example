# Absolute path to the existing local model project.
TARGET_PROJECT="$HOME/local-llm-skills/MacStrata-Qwen3-M3-8GB"

# Optional command used by benchmark.sh.
RUN_SCRIPT="$TARGET_PROJECT/scripts/run_qwen3.sh"

# Benchmark prompt. Keep it short so context size does not dominate.
BENCH_PROMPT="Write a concise explanation of how a mixture-of-experts transformer routes tokens."

# Generation tokens for repeatable comparison.
BENCH_TOKENS=128

# Repeat count.
BENCH_REPEATS=3
